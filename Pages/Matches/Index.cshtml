@page
@model techtalks_forsa.Pages.Matches.IndexModel

@{
    ViewData["Title"] = "Suggested Matches";
}

<div class="page-header">
    <div>
        <h1>Matched for you</h1>
        <p class="page-header__sub">People who teach something in the same category as what you want to learn.</p>
    </div>
</div>

<partial name="_BrowseTabs" />

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success" role="status">@statusMessage</div>
}

@if (!Model.Groups.Any())
{
    <div class="empty">
        <div class="empty__icon" aria-hidden="true">&#10022;</div>
        <h2>No matches yet</h2>
        <p>Add an "I want to learn" listing first, and we'll suggest people who can teach it.</p>
        <a asp-page="/Listings/Create" class="btn btn-primary">Add a listing</a>
    </div>
}
else
{
    @foreach (var group in Model.Groups)
    {
        <section class="match-group">
            <h2 class="match-group__title">Because you want to learn: <span>@group.LearnListing.Title</span></h2>

            @if (!group.MatchingOffers.Any())
            {
                <p class="text-muted">No matches yet in this category. Check back soon, or <a asp-page="/Browse/Index">browse all skills</a>.</p>
            }
            else
            {
                @foreach (var offer in group.MatchingOffers)
                {
                    <div class="match-row">
                        <div>
                            <div class="match-row__title">@offer.Title</div>
                            <span class="chip">@offer.Category</span>
                        </div>
                        <a asp-page="/Browse/Details" asp-route-id="@offer.Id" class="btn btn-outline-primary btn-sm">View</a>
                    </div>
                }
            }
        </section>
    }
}