@page
@model techtalks_forsa.Pages.Listings.CreateModel

@{
    ViewData["Title"] = "New Listing";
}

<a asp-page="/Listings/Index" class="back-link">&larr; Back to My Listings</a>

<div class="page-header">
    <div>
        <h1>New listing</h1>
        <p class="page-header__sub">Tell the community what you can teach, or what you would like to learn.</p>
    </div>
</div>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-4">
        <label asp-for="Input.Type" class="form-label">I want to&hellip;</label>
        <select asp-for="Input.Type" class="form-select">
            <option value="@techtalks_forsa.Models.ListingType.Offer">Teach this (I can teach it)</option>
            <option value="@techtalks_forsa.Models.ListingType.Learn">Learn this (I want to learn it)</option>
        </select>
        <div class="form-text">"Teach" listings appear in Browse. "Learn" listings power your suggested matches.</div>
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Title" class="form-label">Title</label>
        <input asp-for="Input.Title" class="form-control" placeholder="e.g. Grade 1-6 Math" />
        <span asp-validation-for="Input.Title" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Category" class="form-label">Category</label>
        <select asp-for="Input.Category" class="form-select" asp-items="Model.CategoryOptions">
            <option value="">-- Select a category --</option>
        </select>
        <span asp-validation-for="Input.Category" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Description" class="form-label">Description</label>
        <textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="What will you cover? What level? How would you like to teach or learn?"></textarea>
        <span asp-validation-for="Input.Description" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Post listing</button>
        <a asp-page="/Listings/Index" class="btn btn-ghost">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
