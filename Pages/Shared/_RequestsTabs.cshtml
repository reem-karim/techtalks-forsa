@{
    var current = (ViewContext.RouteData.Values["page"] as string) ?? "";
    var onReceived = current.EndsWith("/Incoming", StringComparison.OrdinalIgnoreCase);
    var onSent = current.EndsWith("/Sent", StringComparison.OrdinalIgnoreCase);
    var onSessions = current.StartsWith("/Sessions", StringComparison.OrdinalIgnoreCase);
}
<nav class="tabs" aria-label="Requests and sessions">
    <a class="tab@(onReceived ? " active" : "")" aria-current="@(onReceived ? "page" : null)" asp-page="/SwapRequests/Incoming">Received</a>
    <a class="tab@(onSent ? " active" : "")" aria-current="@(onSent ? "page" : null)" asp-page="/SwapRequests/Sent">Sent</a>
    <a class="tab@(onSessions ? " active" : "")" aria-current="@(onSessions ? "page" : null)" asp-page="/Sessions/Index">Sessions</a>
</nav>