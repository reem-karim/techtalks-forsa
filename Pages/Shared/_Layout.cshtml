@{
    var isIdentityArea = (ViewContext.RouteData.Values["area"] as string) == "Identity";
    var currentPage = (ViewContext.RouteData.Values["page"] as string) ?? "";
    var isSignedIn = User.Identity?.IsAuthenticated == true;

    bool IsActive(params string[] prefixes) =>
        !isIdentityArea && prefixes.Any(p => currentPage.StartsWith(p, StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FBF6EE" />
    <title>@ViewData["Title"] - Forsa</title>
    <script type="importmap"></script>

    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/flow.css" asp-append-version="true" />
</head>
<body class="@(isIdentityArea ? "page-identity" : "")">
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header>
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Main navigation">
            <div class="container">
                <a class="brand" asp-area="" asp-page="/Index" aria-label="Forsa home">
                    <svg width="34" height="34" viewBox="0 0 34 34" aria-hidden="true" focusable="false">
                        <circle cx="12" cy="17" r="10" fill="#5B3BA8" />
                        <circle cx="22" cy="17" r="10" fill="#E9A23B" fill-opacity=".85" />
                    </svg>
                    Forsa
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    @if (isSignedIn)
                    {
                        <ul class="navbar-nav me-auto ms-lg-3 mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link@(IsActive("/Browse", "/Matches") ? " active" : "")" aria-current="@(IsActive("/Browse", "/Matches") ? "page" : null)" asp-area="" asp-page="/Browse/Index">Find a skill</a></li>
                            <li class="nav-item"><a class="nav-link@(IsActive("/Listings") ? " active" : "")" aria-current="@(IsActive("/Listings") ? "page" : null)" asp-area="" asp-page="/Listings/Index">My skills</a></li>
                            <li class="nav-item"><a class="nav-link@(IsActive("/SwapRequests", "/Sessions") ? " active" : "")" aria-current="@(IsActive("/SwapRequests", "/Sessions") ? "page" : null)" asp-area="" asp-page="/SwapRequests/Incoming">Requests</a></li>
                            <li class="nav-item"><a class="nav-link@(IsActive("/Messages") ? " active" : "")" aria-current="@(IsActive("/Messages") ? "page" : null)" asp-area="" asp-page="/Messages/Inbox">Messages</a></li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto ms-lg-3 mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link" asp-area="" asp-page="/Index" asp-fragment="how-it-works">How it works</a></li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main id="main-content" class="container" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container site-footer__inner">
            <span>&copy; 2026 Forsa &middot; Swap skills, not money.</span>
            <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>