@page
@model IndexModel
@{
    ViewData["Title"] = "Swap skills, not money";
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var categories = techtalks_forsa.Models.SkillCategories.All;
}

@if (isSignedIn)
{
    string nextTitle, nextText, nextButton;
    string nextPage;

    if (Model.PendingIncoming > 0)
    {
        nextTitle = Model.PendingIncoming == 1 ? "1 person wants to swap with you" : $"{Model.PendingIncoming} people want to swap with you";
        nextText = "Take a look and accept or decline.";
        nextButton = "Open requests";
        nextPage = "/SwapRequests/Incoming";
    }
    else if (!Model.HasOffer)
    {
        nextTitle = "Add a skill you can teach";
        nextText = "Other members find you through what you offer. Even a hobby counts.";
        nextButton = "Add my skills";
        nextPage = "/Welcome/Skills";
    }
    else if (!Model.HasLearn)
    {
        nextTitle = "Add a skill you want to learn";
        nextText = "We use it to suggest people who can teach you.";
        nextButton = "Add a skill to learn";
        nextPage = "/Welcome/Skills";
    }
    else if (Model.SentCount == 0)
    {
        nextTitle = "Find someone to swap with";
        nextText = "These members teach what you want to learn.";
        nextButton = "See my matches";
        nextPage = "/Matches/Index";
    }
    else
    {
        nextTitle = "You're all set";
        nextText = "Keep exploring skills, or check on your requests.";
        nextButton = "Find a skill";
        nextPage = "/Browse/Index";
    }

    <section class="hero pb-0">
        <p class="eyebrow">Welcome back@(string.IsNullOrWhiteSpace(Model.DisplayName) ? "" : ", " + Model.DisplayName)</p>
        <h1>Your <em>next step</em></h1>
    </section>

    <section class="section pt-3 pb-3">
        <div class="next-card">
            <h2>@nextTitle</h2>
            <p>@nextText</p>
            <a asp-page="@nextPage" class="btn btn-primary btn-lg">@nextButton</a>
        </div>
    </section>

    <section class="section pt-3" aria-labelledby="progress-title">
        <h2 id="progress-title" class="mb-3">Your progress</h2>
        <ul class="checklist">
            <li class="is-done"><span class="checklist__mark" aria-hidden="true">&#10003;</span><span class="checklist__text">Create your profile</span></li>
            <li class="@(Model.HasOffer ? "is-done" : "")"><span class="checklist__mark" aria-hidden="true">&#10003;</span><span class="checklist__text">Add a skill you can teach</span>@if (!Model.HasOffer){<a asp-page="/Welcome/Skills" class="btn btn-outline-primary btn-sm">Add</a>}</li>
            <li class="@(Model.HasLearn ? "is-done" : "")"><span class="checklist__mark" aria-hidden="true">&#10003;</span><span class="checklist__text">Add a skill you want to learn</span>@if (!Model.HasLearn){<a asp-page="/Welcome/Skills" class="btn btn-outline-primary btn-sm">Add</a>}</li>
            <li class="@(Model.SentCount > 0 ? "is-done" : "")"><span class="checklist__mark" aria-hidden="true">&#10003;</span><span class="checklist__text">Send your first swap request</span>@if (Model.SentCount == 0){<a asp-page="/Browse/Index" class="btn btn-outline-primary btn-sm">Browse</a>}</li>
        </ul>
    </section>

    <section class="section pt-0" aria-labelledby="explore-title">
        <h2 id="explore-title" class="mb-3">Explore by category</h2>
        <div class="chip-cloud justify-content-start">
            @foreach (var c in categories)
            {
                <a class="chip-link" asp-page="/Browse/Index" asp-route-Category="@c">@c</a>
            }
        </div>
    </section>
}
else
{
    <section class="hero">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <p class="eyebrow">Free skill exchange</p>
                <h1>Swap skills, <em>not money.</em></h1>
                <p class="hero__lead">Teach what you know, learn what you don't. Forsa connects people who want to trade lessons, with no payments and no pressure.</p>
                <div class="hero__cta">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary btn-lg">Get started, it's free</a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-primary btn-lg">Log in</a>
                </div>
            </div>
            <div class="col-lg-5 d-none d-lg-block" aria-hidden="true">
                <div class="hero-art">
                    <div class="mini mini--1"><span class="chip">I can teach</span><p>Origami for beginners</p><small>Arts &amp; Crafts</small></div>
                    <div class="mini mini--2"><span class="chip chip--learn">I want to learn</span><p>Intro to Python</p><small>Technology</small></div>
                    <div class="mini mini--3"><span class="chip">I can teach</span><p>Conversational French</p><small>Languages</small></div>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="how-it-works" aria-labelledby="how-title">
        <h2 id="how-title" class="section__title">How Forsa works</h2>
        <p class="section__sub">Four simple steps from "I wish I could do that" to your first lesson.</p>
        <div class="row g-4">
            <div class="col-md-6 col-lg-3">
                <div class="step"><span class="step__num">1</span><h3>Create your profile</h3><p>Sign up and tell the community a little about you.</p></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step"><span class="step__num">2</span><h3>Post what you offer and want</h3><p>List a skill you can teach and one you would love to learn.</p></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step"><span class="step__num">3</span><h3>Propose a swap</h3><p>Browse listings or use suggested matches and send a request.</p></div>
            </div>
            <div class="col-md-6 col-lg-3">
                <div class="step"><span class="step__num">4</span><h3>Message and learn</h3><p>When a request is accepted, chat and arrange your session.</p></div>
            </div>
        </div>
    </section>

    <section class="section pt-0" aria-labelledby="cat-title">
        <h2 id="cat-title" class="section__title">Skills people swap</h2>
        <p class="section__sub">From school subjects to cooking and coding.</p>
        <div class="chip-cloud">
            @foreach (var c in categories)
            {
                <a class="chip-link" asp-area="Identity" asp-page="/Account/Register">@c</a>
            }
        </div>
    </section>

    <section class="section pt-0">
        <div class="cta-band">
            <h2>Ready to trade your first skill?</h2>
            <p>Create a free account in under a minute.</p>
            <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent btn-lg">Join Forsa</a>
        </div>
    </section>
}