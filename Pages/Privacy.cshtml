@page
@model PrivacyModel
@{
    ViewData["Title"] = "Privacy";
}

<div class="page-header">
    <div>
        <h1>Privacy</h1>
        <p class="page-header__sub">A plain-language summary of the information Forsa keeps.</p>
    </div>
</div>

<div class="panel" style="max-width: 760px;">
    <h2>What Forsa stores</h2>
    <ul>
        <li>Your account email and a securely hashed password.</li>
        <li>The profile details you choose to add: display name, education, bio, and the skills you teach or want to learn.</li>
        <li>The listings, swap requests and messages you create.</li>
        <li>For guardians: the name, age and grade of any minor profile you add.</li>
    </ul>

    <h2 class="mt-4">Good to know</h2>
    <ul>
        <li>Education and bio details are self-reported and are not independently verified.</li>
        <li>Messages are visible only to the two people in the conversation.</li>
        <li>Please do not share passwords or sensitive personal details in messages or listings.</li>
    </ul>
</div>
