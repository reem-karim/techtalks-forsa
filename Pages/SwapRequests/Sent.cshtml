@page
@model techtalks_forsa.Pages.SwapRequests.SentModel

@{
    ViewData["Title"] = "My Sent Requests";
}

<div class="page-header">
    <div>
        <h1>Swap requests</h1>
        <p class="page-header__sub">Requests you have sent to other members, and how they responded.</p>
    </div>
</div>

<partial name="_RequestsTabs" />

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info" role="status">@statusMessage</div>
}

@if (!Model.Requests.Any())
{
    <div class="empty">
        <div class="empty__icon" aria-hidden="true">&#10022;</div>
        <h2>You haven't sent any requests yet</h2>
        <p>Find a skill you like in Browse, open it, and choose "Propose a skill swap".</p>
        <a asp-page="/Browse/Index" class="btn btn-primary">Browse skills</a>
    </div>
}
else
{
    <div class="request-list">
        @foreach (var r in Model.Requests)
        {
            <article class="request-card">
                <div class="request-card__head">
                    <div>
                        <p class="eyebrow">You asked about</p>
                        <h2 class="request-card__title">@r.TargetListing?.Title</h2>
                    </div>
                    <span class="status status--@(r.Status.ToString().ToLowerInvariant())">@r.Status</span>
                </div>

                <dl class="request-card__meta">
                    <dt>Sent</dt>
                    <dd>@r.CreatedAt.ToLocalTime().ToString("g")</dd>
                </dl>

                @if (r.Status == techtalks_forsa.Models.SwapRequestStatus.Accepted)
                {
                    <div class="request-card__actions">
                          <a asp-page="/Sessions/Propose" asp-route-swapRequestId="@r.Id" class="btn btn-primary btn-sm">Schedule a session</a>
                        <a asp-page="/Messages/Thread" asp-route-userId="@r.TargetListing!.OwnerUserId" class="btn btn-outline-primary btn-sm">Send a message</a>
                    </div>
                }
            </article>
        }
    </div>
}
