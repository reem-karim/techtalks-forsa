@page
@model techtalks_forsa.Pages.Profile.ViewModel

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<div class="card">
    <div class="card-body">

        <h2>Education</h2>

        <p>
            @Model.Profile?.Education
        </p>

        <p class="text-muted">
            Education information is self-reported and has not been verified.
        </p>

        <hr />

        <h2>About Me</h2>

        <p>
            @Model.Profile?.Bio
        </p>

        <hr />

        <h2>I Teach</h2>

        <p>
            @Model.Profile?.Teach
        </p>

        <hr />

        <h2>I Want to Learn</h2>

        <p>
            @Model.Profile?.WantToLearn
        </p>

        <hr />

              @if (Model.Profile?.IsGuardian == true)
        {
            <hr />

            <h2>Guardian</h2>

            <p>
                You are registered as a guardian.
            </p>

            <a asp-page="/Profile/Minor/Create"
               class="btn btn-primary">
                Add Minor Profile
            </a>
        }

        <hr />


    <a asp-page="/Profile/Edit" class="btn btn-primary">
            Edit Profile
        </a>

    </div>
</div>