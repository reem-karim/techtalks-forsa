@page
@model techtalks_forsa.Pages.Profile.EditModel

@{
    ViewData["Title"] = Model.IsFirstSetup ? "Set up your profile" : "Edit Profile";
}

@if (Model.IsFirstSetup)
{
    <div class="setup-steps" aria-label="Setup progress">
        <span class="setup-steps__item is-current">1. Your profile</span>
        <span class="setup-steps__item">2. Your skills</span>
        <span class="setup-steps__item">3. Find a swap</span>
    </div>
}

<div class="page-header">
    <div>
        <h1>@(Model.IsFirstSetup ? "Welcome! Let's set up your profile" : "Edit profile")</h1>
        <p class="page-header__sub">
            @(Model.IsFirstSetup
                ? "Only your name is required. You can add the rest later."
                : "This is what other members see.")
        </p>
    </div>
</div>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Input.RowVersion" />

    <div class="mb-4">
        <label asp-for="Input.DisplayName" class="form-label"></label>
        <input asp-for="Input.DisplayName" class="form-control" placeholder="What should people call you?" autofocus />
        <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Bio" class="form-label"></label>
        <textarea asp-for="Input.Bio" class="form-control" rows="4" placeholder="A sentence or two about you (optional)"></textarea>
        <span asp-validation-for="Input.Bio" class="text-danger"></span>
    </div>

    <details class="more-options mb-4" open="@(Model.Input.IsGuardian || !string.IsNullOrWhiteSpace(Model.Input.Education))">
        <summary>More options</summary>

        <div class="mb-4">
            <label asp-for="Input.Education" class="form-label"></label>
            <textarea asp-for="Input.Education" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Input.Education" class="text-danger"></span>
            <div class="form-text">Self-reported and not verified.</div>
        </div>

        <div class="form-check">
            <input asp-for="Input.IsGuardian" class="form-check-input" />
            <label asp-for="Input.IsGuardian" class="form-check-label"></label>
            <div class="form-text">Select this only if you are an adult looking after a minor.</div>
        </div>
    </details>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">@(Model.IsFirstSetup ? "Save and continue" : "Save profile")</button>
        @if (!Model.IsFirstSetup)
        {
            <a asp-page="/Profile/View" class="btn btn-ghost">Cancel</a>
        }
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}