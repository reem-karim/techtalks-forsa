@page "{id:int}"
@model techtalks_forsa.Pages.Profile.Minor.ViewModel

@{
    ViewData["Title"] = "Minor Profile";
}

<h1>Minor Profile</h1>

<div class="card">
    <div class="card-body">

        <h2>@Model.MinorProfile?.Name</h2>

        <p>
            <strong>Age:</strong>
            @Model.MinorProfile?.Age
        </p>

        <p>
            <strong>Grade:</strong>
            @Model.MinorProfile?.Grade
        </p>

        <hr />

        <p class="text-muted">
            This is a guardian-managed minor profile.
            The minor does not have a login account.
        </p>

    </div>
</div>