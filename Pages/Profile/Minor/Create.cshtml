@page
@model techtalks_forsa.Pages.Profile.Minor.CreateModel

@{
    ViewData["Title"] = "Add Minor Profile";
}

<a asp-page="/Profile/View" class="back-link">&larr; Back to my profile</a>

<div class="page-header">
    <div>
        <h1>Add minor profile</h1>
        <p class="page-header__sub">This profile is managed by the guardian and does not have its own login account.</p>
    </div>
</div>

<form method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-4">
        <label asp-for="Input.Name" class="form-label"></label>
        <input asp-for="Input.Name" class="form-control" />
        <span asp-validation-for="Input.Name" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Age" class="form-label"></label>
        <input asp-for="Input.Age" class="form-control" type="number" />
        <span asp-validation-for="Input.Age" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Input.Grade" class="form-label"></label>
        <input asp-for="Input.Grade" class="form-control" placeholder="Example: Grade 7" />
        <span asp-validation-for="Input.Grade" class="text-danger"></span>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Create minor profile</button>
        <a asp-page="/Profile/View" class="btn btn-ghost">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
