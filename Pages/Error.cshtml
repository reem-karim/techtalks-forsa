@page
@model ErrorModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="empty">
    <div class="empty__icon" aria-hidden="true">!</div>
    <h1 class="h2">Something went wrong</h1>
    <p>We hit an unexpected problem while loading this page. Please try again, or head back to the home page.</p>
    <a asp-page="/Index" class="btn btn-primary">Back to home</a>

    @if (Model.ShowRequestId)
    {
        <p class="small mt-4 mb-0">Reference for the team: <code>@Model.RequestId</code></p>
    }
</div>
