@page
@model techtalks_forsa.Pages.Messages.ThreadModel

@{
    ViewData["Title"] = "Conversation with " + Model.OtherDisplayName;
}

<a asp-page="/Messages/Inbox" class="back-link">&larr; All messages</a>

<div class="thread-head">
    <span class="avatar avatar--lg" aria-hidden="true">@(Model.OtherDisplayName.Length > 0 ? Model.OtherDisplayName.Substring(0, 1).ToUpperInvariant() : "?")</span>
    <h1>@Model.OtherDisplayName</h1>
</div>

<div id="chat-window" class="chat" role="log" aria-live="polite" aria-label="Conversation with @Model.OtherDisplayName">
    @foreach (var m in Model.Messages)
    {
        var isFromOther = m.SenderId == Model.UserId;
        <div class="bubble @(isFromOther ? "bubble--them" : "bubble--me")">
            <span class="visually-hidden">@(isFromOther ? Model.OtherDisplayName : "You"):</span>
            <span class="bubble__text">@m.Content</span>
            <span class="bubble__time">@m.SentAt.ToLocalTime().ToString("g")</span>
        </div>
    }
    @if (!Model.Messages.Any())
    {
        <p class="chat__empty">No messages yet. Say hello!</p>
    }
</div>

@if (Model.CanSend)
{
    <form method="post" class="composer">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="UserId" />
        <div class="flex-grow-1">
            <label asp-for="Input.Content" class="visually-hidden">Message</label>
            <textarea asp-for="Input.Content" class="form-control" rows="2" placeholder="Type a message..."></textarea>
            <span asp-validation-for="Input.Content" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
}
else
{
    <p class="text-muted small mt-3">You can send messages once a swap request between you has been accepted.</p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
